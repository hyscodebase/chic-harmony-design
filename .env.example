# Public Supabase configuration. VITE_* values are included in the browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-side Supabase configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI-compatible chat-completions provider (server-only).
AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.example.com/v1/chat/completions
AI_MODEL=your_json_capable_model

# Only the in-memory sandbox adapter is implemented.
KB_PAYMENT_MODE=mock
